# ---- Convex ----
# Filled in automatically the first time you run `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# ---- Admin login (Next.js side) ----
# The only login this app has: one shared admin account.
# Pick a real password and a long random string for COOKIE_SECRET.
ADMIN_EMAIL=admin@atlassteward.com
ADMIN_PASSWORD=document.write
# Generate a random 32+ character string, e.g. `openssl rand -hex 32`
COOKIE_SECRET=replace-with-a-long-random-string

# Must be the SAME value set in Convex's environment (see README) --
# this is what lets the Next.js server prove to Convex that a request
# is coming from the authenticated admin area, not a random visitor.
ADMIN_API_SECRET=replace-with-a-different-long-random-string

# ---- Email (Resend) ----
# Sign up at https://resend.com, verify a sending domain (or use their
# onboarding@resend.dev sandbox address while testing), and set this
# same key in Convex's environment too (see README).


# NOTE: RESEND_API_KEY, RESEND_FROM_EMAIL, ADMIN_API_SECRET, and ADMIN_EMAIL
# (used as the contact-form notification recipient) must ALSO be set in
# Convex's own environment — see README step 2. This file only configures
# the Next.js side.
